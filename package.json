{
  "name": "turnpups-mos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turnpups Management Operating System. Daily readout across three layers: leadership priorities, ClickUp sprint execution, active Intelligems tests.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:watch": "node --test --watch \"test/*.test.js\"",
    "check": "node scripts/syntax-check.js",
    "readout:dry": "node scripts/run-local.js --mode=refresh --dry-run",
    "readout:local": "node scripts/run-local.js --mode=official",
    "dev": "netlify dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.70.0",
    "@netlify/blobs": "^8.1.0"
  },
  "devDependencies": {
    "netlify-cli": "^17.0.0"
  }
}
