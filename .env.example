# Copy this file to .env and fill in what you have:
#
#     cp .env.example .env
#
# .env is gitignored. Never commit real values. For the deployed site these same names
# go in Netlify under Site configuration > Environment variables, not in a file.

# ---------------------------------------------------------------------------
# A DRY RUN NEEDS ONLY THESE TWO. Everything else below is for the deployed system.
# Either one on its own still produces a readout; the other layer reports as missing.
# ---------------------------------------------------------------------------

# ClickUp personal API token.
# ClickUp > click your avatar (bottom left) > Settings > Apps > API Token > Generate.
# Sent as `Authorization: pk_...` with NO Bearer prefix.
CLICKUP_TOKEN=

# Intelligems External API key.
# Intelligems > Integrations > External API > Enable, then copy the key.
# Sent as the `intelligems-access-token` header.
INTELLIGEMS_TOKEN=

# ---------------------------------------------------------------------------
# Not needed for a dry run. Required before the 8 AM send, the dashboard,
# the advisor button or the learning loop will work.
# ---------------------------------------------------------------------------

# Slack bot token (xoxb-...) with chat:write, plus the signing secret that verifies
# inbound requests, plus the channel the readout is posted to.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# The channel ID, NOT the #name. Starts with C (e.g. C0123456789).
# Slack: right-click the channel > View channel details > scroll down > Channel ID.
# The bot must be a member of it: /invite @Turnpups MOS
SLACK_READOUT_CHANNEL=

# Anthropic. Used ONLY by the Strategic Advisor and the Learning Skill.
# Zero spend on a normal day.
ANTHROPIC_API_KEY=

# GitHub token scoped to THIS ONE REPO: contents:write + pull_requests:write. Nothing
# wider. This is how the learning skill proposes changes for approval.
GITHUB_TOKEN=
#
# NOTE: the repo and branch are NOT here. They live in config/system.json > github,
# because they are settings rather than secrets. Do not set them as environment
# variables: Netlify's secrets scanner treats every environment value as something to
# find and fail on, and a branch value of "main" matches every <main> tag and every
# "domain"/"remaining" in the build output.

# Dashboard auth. The password you type to log in, and a random secret that signs the
# session cookie. Generate the secret with:  openssl rand -base64 32
# DASHBOARD_COOKIE_SECRET also gates the internal pipeline invoke, so nothing can start
# a run without it.
# NOT the project name, the repo name, or anything else that appears in the codebase.
# Netlify scans the build output for every environment value and refuses to publish when
# it finds one, which is the correct behaviour: a password equal to "turnpups-mos" is
# guessable from the repo alone. Generate one:  openssl rand -base64 18
DASHBOARD_PASSWORD=

# openssl rand -base64 32
DASHBOARD_COOKIE_SECRET=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# MOS_STORAGE=fs|blobs|memory   default: blobs on Netlify, fs locally
# MOS_DATA_DIR=.data            where the fs backend writes snapshots
# MOS_LOG_LEVEL=debug|info|warn|error
